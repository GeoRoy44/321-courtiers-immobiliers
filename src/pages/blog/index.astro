---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles } from '../../data/articles';
---
<BaseLayout title="Guides sur le courtage et le crédit immobilier" description="Des guides pratiques pour choisir un courtier, préparer son dossier de prêt immobilier et comprendre les étapes d’un financement.">
  <section class="page-hero page-hero-compact"><div class="container narrow"><p class="eyebrow">Guides crédit immobilier</p><h1>Comprendre le courtage avant de vous engager.</h1><p class="lead">Des contenus pratiques, rédigés pour vous aider à préparer votre projet et à poser les bonnes questions.</p></div></section>
  <section class="section"><div class="container article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div></section>
</BaseLayout>
