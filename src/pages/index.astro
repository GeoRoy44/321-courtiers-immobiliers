---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSearch from '../components/HeroSearch.astro';
import CityLinks from '../components/CityLinks.astro';
import DirectoryNotice from '../components/DirectoryNotice.astro';
import CityBrokers from '../components/CityBrokers.astro';
import HomeFaq from '../components/HomeFaq.astro';
import { courtiers } from '../data/courtiers';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../data/articles';

const heroImage = 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=1280&q=80';
---
<BaseLayout title="321 Courtiers Immobiliers | Trouver un courtier près de chez vous" description="Recherchez des courtiers en prêt immobilier par ville, découvrez notre méthode et consultez des guides pour préparer votre financement.">
  <Fragment set:html={'<!-- 942f6c4d9432c1157e925d4faaa718b1 -->'} />
  <section class="home-hero home-hero-compact">
    <div class="container hero-compact-grid">
      <div class="hero-compact-copy">
        <p class="eyebrow">Annuaire éditorial indépendant</p>
        <h1 class="hero-compact-title">Trouvez un courtier en prêt immobilier près de chez vous.</h1>
        <p class="lead hero-compact-lead">Retrouvez {courtiers.length} agences documentées à Nantes, Rennes et Reims. Consultez leurs coordonnées déclarées et nos guides pour préparer votre projet immobilier.</p>
        <HeroSearch />
      </div>
      <figure class="hero-compact-media">
        <img src={heroImage} width="640" height="520" alt="Couple recevant les clés de son logement après un financement immobilier" loading="eager" decoding="async" fetchpriority="high" />
      </figure>
    </div>
    <div class="container">
      <aside class="hero-bubble" aria-label="Notre méthode">
        <p class="eyebrow">Recherche utile</p>
        <strong>Des repères clairs avant de choisir.</strong>
        <ul class="check-list">
          <li>Agences recensées dans trois villes</li>
          <li>Critères pour comparer les professionnels</li>
          <li>Distinction entre contenu éditorial et partenariat</li>
        </ul>
      </aside>
    </div>
  </section>
  <section class="section section-tint">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Commencer par votre ville</p><h2>Les agences près de vous</h2></div><a href="/annuaire-courtiers-pret-immobilier/">Tout l’annuaire →</a></div>
      <CityLinks />
      <div class="section-space"><DirectoryNotice /></div>
    </div>
  </section>
  <section class="section">
    <div class="container steps-grid">
      <div><p class="eyebrow">Avant de contacter un professionnel</p><h2>Les 3 repères qui rendent la recherche plus simple.</h2></div>
      <article><span>01</span><h3>Cadrez votre projet</h3><p>Type de bien, budget, apport, revenus et calendrier : vous gagnez du temps dès le premier échange.</p></article>
      <article><span>02</span><h3>Comparez la méthode</h3><p>Demandez comment le professionnel étudie le dossier, consulte les banques et présente sa rémunération.</p></article>
      <article><span>03</span><h3>Lisez les conditions globales</h3><p>Le taux ne suffit pas : assurance, garanties, frais et souplesse du prêt comptent aussi.</p></article>
    </div>
  </section>
  <section class="section section-tint">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">Préparer votre financement</p><h2>Les derniers guides</h2></div><a href="/blog/">Tous les guides →</a></div>
      <div class="article-grid">{articles.slice(0, 20).map((article) => <ArticleCard article={article} />)}</div>
    </div>
  </section>
  <section class="section section-dark">
    <div class="container cta-panel">
      <div>
        <p class="eyebrow">Prêt à commencer ?</p>
        <h2>Préparez votre recherche de financement.</h2>
        <p class="cta-text">Un bon financement se prépare avant le premier rendez-vous : connaître votre capacité d’emprunt, votre apport et le coût réel d’un crédit vous place en position de force face aux banques comme aux courtiers. Nos guides expliquent pas à pas le TAEG, l’assurance emprunteur, le prêt à taux zéro et les documents à réunir pour un dossier solide. Lisez-les, puis revenez choisir un courtier dans votre ville avec les bonnes questions en tête.</p>
      </div>
      <a class="button button-light" href="/blog/">Consulter les guides</a>
    </div>
  </section>
  <CityBrokers />
  <HomeFaq />
</BaseLayout>

<style>
  .home-hero-compact { padding: 64px 0 56px; }
  .hero-compact-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(300px, .85fr); align-items: center; gap: 48px; }
  .hero-compact-title { font-size: clamp(2.1rem, 3.6vw, 3.2rem); letter-spacing: -.03em; margin-bottom: 16px; }
  .hero-compact-lead { font-size: clamp(1rem, 1.4vw, 1.12rem); margin-bottom: 0; }
  .hero-compact-copy :global(.finder) { margin-top: 24px; }
  .hero-compact-media { margin: 0; }
  .hero-compact-media img { display: block; width: 100%; height: auto; max-height: 520px; object-fit: cover; border-radius: var(--radius); box-shadow: var(--shadow); }
  .hero-bubble { position: relative; max-width: 760px; margin-top: 44px; padding: 28px 32px; border: 1px solid #cfe0eb; border-radius: var(--radius); background: var(--navy); color: #e9f3f8; box-shadow: var(--shadow); }
  .hero-bubble::before { content: ''; position: absolute; top: -12px; left: 48px; width: 24px; height: 24px; background: var(--navy); border-left: 1px solid #cfe0eb; border-top: 1px solid #cfe0eb; transform: rotate(45deg); }
  .hero-bubble .eyebrow { color: var(--accent); }
  .hero-bubble strong { display: block; margin-bottom: 16px; color: white; font-family: 'DM Serif Display', Georgia, serif; font-size: 1.5rem; font-weight: 400; line-height: 1.15; }
  .hero-bubble :global(.check-list) { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 24px; }
  .hero-bubble :global(.check-list li::after) { border-color: var(--navy); }
  .cta-panel h2 { margin-bottom: 16px; }
  .cta-text { max-width: 620px; margin: 0; color: #c9d8e2; font-size: .98rem; line-height: 1.7; }
  @media (max-width: 900px) {
    .hero-compact-grid { grid-template-columns: 1fr; gap: 28px; }
    .hero-compact-media { order: -1; }
    .hero-compact-media img { max-height: 320px; }
    .hero-bubble :global(.check-list) { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .home-hero-compact { padding: 40px 0 44px; }
    .hero-compact-title { font-size: 2rem; }
    .hero-bubble { padding: 22px 20px; margin-top: 36px; }
    .cta-text { font-size: .92rem; }
  }
</style>
