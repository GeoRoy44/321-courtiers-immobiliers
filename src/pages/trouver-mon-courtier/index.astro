---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CityLinks from '../../components/CityLinks.astro';
import DirectoryListing from '../../components/DirectoryListing.astro';
import DirectoryNotice from '../../components/DirectoryNotice.astro';
---
<BaseLayout title="Trouver un courtier en prêt immobilier | Recherche par ville" description="Recherchez parmi les agences de courtage recensées à Nantes, Rennes et Reims. Consultez les adresses, services déclarés et coordonnées disponibles.">
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">Préparer sa recherche</p>
      <h1>Trouvez une agence dans votre ville.</h1>
      <p class="lead">Le premier lot couvre Nantes, Rennes et Reims. Parcourez les pages locales ou filtrez les fiches par ville, nom, adresse ou service déclaré.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>Les villes disponibles</h2>
      <CityLinks />
      <div class="section-space">
        <h2>Les agences de l’annuaire</h2>
        <DirectoryNotice />
        <DirectoryListing />
      </div>
      <article class="prose narrow section-space">
        <h2>Les repères pour comparer les professionnels</h2>
        <ol class="numbered-list">
          <li><strong>Préparez votre projet</strong> : budget, apport, travaux éventuels et calendrier.</li>
          <li><strong>Vérifiez l’identité professionnelle</strong> et les informations publiques du cabinet que vous envisagez de contacter.</li>
          <li><strong>Demandez des explications claires</strong> sur le mandat, les honoraires et l’accompagnement proposé.</li>
        </ol>
      </article>
    </div>
  </section>
</BaseLayout>
