---
interface Props {
  article: { title: string; href: string; category: string; description: string };
}
const { article } = Astro.props;
---
<article class="article-card">
  <span>{article.category}</span>
  <h2><a href={article.href}>{article.title}</a></h2>
  <p>{article.description}</p>
  <a href={article.href}>Lire le guide <span aria-hidden="true">→</span></a>
</article>
