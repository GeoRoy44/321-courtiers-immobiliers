---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSearch from './HeroSearch.astro';
import { cities } from '../data/courtiers';
import { localContent } from '../data/local-content';

interface Props {
  city: string;
  title: string;
  description: string;
  intro: string;
  contextTitle: string;
  context: string;
  projects: { title: string; text: string }[];
  questions: { question: string; answer: string }[];
}
const { city, title, description, intro, contextTitle, context, projects, questions } = Astro.props;
const location = city === 'Les Sorinières' ? 'aux Sorinières' : `à ${city}`;
const sections = localContent[city] ?? [];
const nearbyCities = cities.filter((item) => item.status === 'Guide local disponible' && item.name !== city);
---
<BaseLayout title={title} description={description}>
  <section class="page-hero page-hero-compact">
    <div class="container narrow">
      <p class="eyebrow">Guide local · Loire-Atlantique</p>
      <h1>Courtier en prêt immobilier {location}</h1>
      <p class="lead">{intro}</p>
      <HeroSearch />
    </div>
  </section>
  <section class="section">
    <div class="container content-grid">
      <article class="prose">
        <h2>{contextTitle}</h2>
        <p>{context}</p>
        <h2>Les projets à préparer {location}</h2>
        <div class="service-grid">
          {projects.map((project) => <section class="service-card"><h3>{project.title}</h3><p>{project.text}</p></section>)}
        </div>
        {sections.map((section) => <section><h2>{section.title}</h2>{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</section>)}
        <h2>Comment choisir un courtier dans votre secteur ?</h2>
        <p>Comparez le périmètre d’intervention, les spécialités, la disponibilité, les modalités d’honoraires et les informations réglementaires présentées par chaque professionnel. Demandez toujours une explication claire de son mandat et de sa rémunération avant de vous engager.</p>
        <h2>Préparer le dossier et comparer les propositions</h2>
        <p>Commencez par exposer le projet, les revenus, les charges, l’apport et les échéances à respecter. Demandez ensuite la liste des justificatifs et, si vous choisissez un courtier, un mandat décrivant son intervention. Signalez les banques déjà contactées pour clarifier la suite des démarches.</p>
        <p>Comparez les propositions écrites sur le montant, la durée, l’assurance, les garanties et le coût global. Notre <a href="/blog/pret-immobilier/">guide du prêt immobilier</a> détaille ces critères et renvoie aux règles officielles sur le TAEG, le PTZ et l’offre de prêt.</p>
        <p class="notice">Ce contenu est un guide éditorial indépendant, pas la présentation d’un cabinet local. Il ne garantit ni financement, ni taux, ni éligibilité à une aide.</p>
        <h2>Questions fréquentes</h2>
        <div class="faq-list">
          {questions.map((item) => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
        </div>
        <h2>Explorer les communes voisines</h2>
        <ul>{nearbyCities.map((item) => <li><a href={`/${item.slug}/`}>Préparer un financement : {item.name}</a></li>)}</ul>
      </article>
      <aside class="sidebar-card">
        <p class="eyebrow">À retenir</p>
        <h2>Votre recherche {location}</h2>
        <ul class="check-list">
          <li>Vérifiez les informations et la date de mise à jour.</li>
          <li>Demandez le détail des honoraires.</li>
          <li>Comparez les conditions globales, pas seulement le taux.</li>
          <li>Préparez revenus, apport et projet avant le premier échange.</li>
        </ul>
        <a class="button button-dark" href="/annuaire-courtiers-pret-immobilier/">Consulter l’annuaire</a>
        <a class="button" href="/blog/pret-immobilier/">Comprendre le prêt immobilier</a>
      </aside>
    </div>
  </section>
  <section class="section section-tint">
    <div class="container cta-panel">
      <div><p class="eyebrow">Besoin d’un point de départ ?</p><h2>Trouvez les fiches disponibles autour de chez vous.</h2></div>
      <a class="button" href="/trouver-mon-courtier/">Rechercher par ville</a>
    </div>
  </section>
</BaseLayout>
