<form class="finder" action="/trouver-mon-courtier/" method="get" data-finder>
  <label for="city-search">Votre ville ou votre code postal</label>
  <div class="finder-row">
    <input id="city-search" name="ville" placeholder="Votre ville ou code postal" autocomplete="postal-code" />
    <button class="button" type="submit">Trouver un courtier</button>
  </div>
  <p class="finder-note">L’annuaire est en préparation. Aucune fiche professionnelle n’est encore publiée.</p>
</form>
